# ----------------------------------------------------------------------
# .htaccess - Clean URLs config for Saint Albert University Web Portal
# Removes .php extensions from URLs on Apache/cPanel hosting.
# ----------------------------------------------------------------------

RewriteEngine On

# 1. Prevent loop if the request is an actual directory
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Redirect /page.php to /page (External Redirect for SEO & Consistency)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[?\s] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Rewrite /page to /page.php (Internal rewrite)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
